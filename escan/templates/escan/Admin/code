<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal{{ user.id }}" tabindex="-1" aria-labelledby="editUserModalLabel{{ user.id }}" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editUserModalLabel{{ user.id }}">Update ang mga Gumagamit</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="POST" id="editUserForm" enctype="multipart/form-data" action="{% url 'edit_user' user.id %}">
                    {% csrf_token %}
                    <input type="hidden" name="user_id" id="editUserId">

                    <!-- First Name -->
                    <div class="mb-2">
                        <label>Unang Pangalan:</label>
                        <input type="text" name="first_name" id="editFirstName" class="form-control" value="{{ user.first_name }}" required>
                    </div>

                    <!-- Last Name -->
                    <div class="mb-2">
                        <label>Apelyido:</label>
                        <input type="text" name="last_name" id="editLastName" class="form-control" value="{{ user.last_name }}" required>
                    </div>

                    <!-- Username -->
                    <div class="mb-2">
                        <label>Gamit na Pangalan:</label>
                        <input type="text" name="username" id="editUsername" class="form-control" value="{{ user.username }}" required>
                    </div>

                    <!-- Email -->
                    <div class="mb-2">
                        <label>Email:</label>
                        <input type="email" name="email" id="editEmail" class="form-control" value="{{ user.email }}" required>
                    </div>

                    <!-- Password -->
                    <div class="mb-2">
                        <label for="editPassword">Password (Leave empty to keep current):</label>
                        <input type="password" name="password" id="editPassword" class="form-control">
                    </div>

                    <!-- Profile Image -->
                    <div class="mb-2">
                        <label for="editImageUrl">Profile Image:</label>
                        <input type="file" name="image_url" id="editImageUrl" class="form-control">
                        <div>
                            <!-- Display Current Image -->
                            <img id="editUserImage" src="{{ user.image_url }}" alt="Current Image" width="100" height="100"/>
                        </div>
                    </div>

                    <!-- Role -->
                    <div class="mb-3">
                        <label for="editRole">Role:</label>
                        <select name="role" id="editRole" class="form-control">
                            <option value="User" {% if user.role == 'User' %} selected {% endif %}>User</option>
                            <option value="Admin" {% if user.role == 'Admin' %} selected {% endif %}>Admin</option>
                        </select>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-warning">Update ang User</button>
                </form>
            </div>
        </div>
    </div>
</div>

