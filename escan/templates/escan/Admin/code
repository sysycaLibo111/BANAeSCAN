@media (max-width: 1024px) {
    body {
        font-size: 90%; 
    }

    /* Sidebar */
    nav.sidebar {
        width: 250px; /* Reduce sidebar width */
        position: fixed;
        
    }

    nav .menu a {
        font-size: 24px; /* Reduce menu font size */
    }

    /* Content */
    .content {
        margin-left: 350px; /* Adjust for new sidebar width */
    }

    /* Card */
    .card {
        width: 15in; /* Reduce card width */
        height: auto; /* Allow height to adjust */
    }

    /* Nav Bar */
    .nav-bar p {
        font-size: 22px; /* Reduce font size */
    }

    .search-box input[type="text"],
    .search-box .btn,
    .top .btn {
        font-size: 22px; /* Reduce button and input size */
    }
}

@media (max-width: 754px) {
    /* General Scaling */
    body {
        font-size: 80%; /* Further reduce base font size */
    }

    /* Sidebar */
    nav.sidebar {
        width: 0; /* Hide sidebar */
        background-color: #c1b22e;
        transform: translateX(-100%); /* Move sidebar off-screen */
    }

    .burger {
        display: block; /* Show burger menu */
    }

    /* Content */
    .content {
        margin-left: 0; /* Full width */
        padding: 10px; /* Reduce padding */
    }

    /* Card */
    .card {
        width: 12in; /* Further reduce card width */
        margin-left: 5in;
    }

    /* Nav Bar */
    .nav-bar p {
        font-size: 20px; /* Further reduce font size */
    }

    .search-box input[type="text"],
    .search-box .btn,
    .top .btn {
        font-size: 20px; /* Further reduce button and input size */
    }
}

@media (max-width: 324px) {
    /* General Scaling */
    body {
        font-size: 70%; /* Smallest base font size */
    }

    /* Sidebar */
    nav.sidebar {
        width: 0; /* Hide sidebar */
        transform: translateX(-100%); /* Move sidebar off-screen */
    }

    .burger {
        display: block; /* Show burger menu */
    }

    /* Content */
    .content {
        margin-left: 0; /* Full width */
        padding: 5px; /* Minimal padding */
    }

    /* Card */
    .card {
        width: 10in; /* Smallest card width */
       
    }

    /* Nav Bar */
    .nav-bar p {
        font-size: 18px; /* Smallest font size */
    }

    .search-box input[type="text"],
    .search-box .btn,
    .top .btn {
        font-size: 18px; /* Smallest button and input size */
    }
}


